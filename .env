API_ADDR=:8080
API_KEY=change-me
DATABASE_URL=postgres://reconix:reconix@postgres:5432/reconix?sslmode=disable
RECONIX_BINARY=/usr/local/bin/reconix
RECONIX_CONFIG=/opt/reconix/config/config.yaml
RECONIX_WORKDIR=/opt/reconix
MAX_CONCURRENT_SCANS=2
MAX_SCAN_DURATION_SECONDS=900
MAX_OUTPUT_SIZE=16777216
TARGET_POLICY_MODE=allowlist
ALLOWED_DOMAINS=example.com
ALLOWED_CIDRS=
